# =================================================================
# CareerMatch AI - Root Environment Configuration Template
# Copy this file to server/.env or configure each service folder
# =================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Google Gemini API Configuration
# Get your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Supported Gemini Model (e.g., gemini-2.5-flash, gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Maximum Upload File Size in Megabytes (PDF resumes)
MAX_FILE_SIZE_MB=5

# Optional Database (Core application runs without database)
# MONGODB_URI=mongodb://localhost:27017/careermatch
